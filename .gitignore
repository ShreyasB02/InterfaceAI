!evidence/replay/example_run/

# Artifact store — keep the seeded example artifact, ignore scratch ones.
artifacts/store/*.json
!artifacts/store/lookup_member_balance.v1.json
!artifacts/store/open_sub_account.v1.json

*.db
.DS_Store
