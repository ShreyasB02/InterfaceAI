# --- LLM providers (discovery run only — replay never calls a model) ---
# Ordered, comma-separated. On a rate limit / overload / timeout the run
# retries with backoff, then fails over to the next provider in the list.
# Leave unset to use every provider below that has an API key, in this order:
# gemini, openrouter, openai, groq, openai_compat.
LLM_PROVIDERS=openrouter,gemini
# Extra attempts per provider on a transient failure before failing over.
LLM_MAX_RETRIES=3

# The model must support tool calling. Vision is on by default; if your model
# can't take images, run discovery with --no-vision.

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (https://openrouter.ai/keys) — one key, many vendors' models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (no default model — set one that supports tool calling)
GROQ_API_KEY=
GROQ_MODEL=

# Any other OpenAI-compatible endpoint (Together, a local Ollama/vLLM, ...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Target app ---
# Base URL of the mock legacy banking console (run `python target_app/app.py` first)
TARGET_APP_BASE_URL=http://127.0.0.1:5055

# --- Target app login (session bootstrap) ---
# Unset: the mock target app's own demo login is used. Never recorded,
# logged, or shown to the model either way.
TARGET_APP_EMPLOYEE_ID=
TARGET_APP_PASSCODE=

# --- Safety guardrails (guardrails/allowlist.py) ---
# Hosts the session may talk to. Required: empty means everything is blocked.
ALLOWLIST_DOMAINS=127.0.0.1:5055,localhost:5055
# Path globs permitted on those hosts. Unset: every path on an allowed host.
ALLOWLIST_ROUTES=/,/login,/members/*
# Action types that may be used at all. Unset: all of
# navigate,click,fill,wait_for,assert_text,extract,handle_dialog
ALLOWLIST_ACTIONS=
# Path globs where a non-GET request counts as risky/irreversible: it is
# aborted unless a human cleared the action that made it.
RISKY_ROUTES=*/confirm

# --- Escalation ---
# Port for the mock operator console (human takeover UI)
OPERATOR_CONSOLE_PORT=5056
